                    if (currentTes.status === 'Tutup') {
                      return (
                        <div style={{ textAlign: 'center', padding: '40px', backgroundColor: '#ffebee', border: '1px solid #ffcdd2', borderRadius: '8px', color: '#c62828' }}>
