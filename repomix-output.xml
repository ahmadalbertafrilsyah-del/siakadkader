                   Persentase & Nilai
                 </button>
              </div>

              <div style={{ padding: '3px' }}>

                {/* TAB 1: RAPORT KADERISASI */}
                {tabRaport === 'raport' && (
                  <div id="area-cetak-raport" style={{ width: '100%', overflowX: 'auto', padding: '10px 0', boxSizing: 'border-box' }}>
