              <span style={{ fontSize: '0.95rem' }}>Belum ada file di Perpustakaan Digital saat ini.</span>
            </div>
          ) : (
            Object.keys(groupedPerpus).sort().map(folder => (
              <div key={folder} className="folder-section">
                
                {/* Judul Folder */}
