                {totalBobotTersimpan >= 100 && <p style={{fontSize: '0.75rem', color: '#e74c3c', marginTop: '10px'}}>Total bobot sudah 100%, Anda tidak bisa menambah kategori baru sebelum menghapus yang lama.</p>}
