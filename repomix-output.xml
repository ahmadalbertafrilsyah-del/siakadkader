                          { label: 'Tanggal Lahir', key: 'tanggalLahir' },
                          { label: 'Asal Instansi/Rayon', key: 'id_rayon', readOnly: true, isInstansi: true },
                          { label: 'Alamat Asal (Lengkap)', key: 'alamatAsal' },
